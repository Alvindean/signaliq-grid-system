{
  "project": "bold-donation-swarm",
  "version": "1.0.0",
  "client": "BOLD Ministries",
  "campaign": "$1M Capital Campaign — Affordable Senior Housing, Rockdale County GA",
  "agency": "Nu Wav Media / Rank Marketing",
  "created": "2025-04-07",

  "pipeline": {
    "pattern": "3x1",
    "parallel_pairs": [["a1", "a2"], ["a3", "a4"]],
    "sequential": ["a5", "a6", "a7", "a8", "a9"],
    "background": ["qc2", "r2"]
  },

  "agents": {
    "a0": {
      "name": "Orchestrator",
      "layer": "control",
      "model": "claude-opus-4-5",
      "role": "Routes traffic, manages swarm state, directs all subagents",
      "triggers": ["session_start", "pipeline_complete", "qc_fail", "analytics_signal"],
      "file": "agents/a0-orchestrator.md"
    },
    "a1": {
      "name": "Researcher",
      "layer": "pre-launch",
      "model": "claude-sonnet-4-5",
      "role": "Donor personas, benchmarks, competitor funnel audits, giving trends",
      "tools": ["web_search", "supabase"],
      "outputs": ["outputs/research/brief.json"],
      "runs_parallel_with": "a2",
      "file": "agents/a1-researcher.md"
    },
    "a2": {
      "name": "Traffic Qualifier",
      "layer": "entry",
      "model": "claude-haiku-4-5",
      "role": "UTM tagging, visitor intent scoring, donor segmentation",
      "tools": ["supabase"],
      "outputs": ["outputs/research/segments.json"],
      "runs_parallel_with": "a1",
      "file": "agents/a2-traffic-qualifier.md"
    },
    "a3": {
      "name": "Funnel Copywriter",
      "layer": "copy",
      "model": "claude-sonnet-4-5",
      "role": "Hero copy, gift tiers, urgency blocks, $1M campaign messaging",
      "depends_on": ["a1"],
      "tools": ["supabase"],
      "outputs": ["outputs/copy/donation-page.json", "outputs/copy/thankyou-page.json"],
      "runs_parallel_with": "a4",
      "file": "agents/a3-copywriter.md"
    },
    "a4": {
      "name": "Page Builder",
      "layer": "build",
      "model": "claude-sonnet-4-5",
      "role": "Stripe form, gift tiers, progress bar, matching gift upsell, Vercel deploy",
      "depends_on": ["a2", "a3"],
      "tools": ["stripe", "vercel", "supabase"],
      "outputs": ["outputs/pages/donation.html", "outputs/pages/thankyou.html"],
      "note": "Runs in parallel with A3 for scaffolding, but needs A3 copy output for final page assembly",
      "file": "agents/a4-page-builder.md"
    },
    "a5": {
      "name": "QC Gate",
      "layer": "gate-1",
      "model": "claude-opus-4-5",
      "role": "Compliance, brand voice, Stripe UX, WCAG 2.1 AA, 501c3 language",
      "depends_on": ["a3", "a4"],
      "checks": [
        "501c3_language",
        "brand_voice",
        "stripe_ux",
        "wcag_aa",
        "mobile_render",
        "seo_meta"
      ],
      "on_fail": "block_launch_return_to_a3",
      "on_pass": "trigger_a6",
      "outputs": ["outputs/qc-reports/gate1.json"],
      "file": "agents/a5-qc-gate.md"
    },
    "a6": {
      "name": "Abandonment Recovery",
      "layer": "layer-3",
      "model": "claude-haiku-4-5",
      "role": "Exit intent popup, retargeting pixel, SMS + email rescue via GHL",
      "depends_on": ["a5"],
      "tools": ["make", "supabase"],
      "outputs": ["outputs/copy/abandonment-popup.json", "outputs/copy/rescue-sequence.json"],
      "file": "agents/a6-abandonment.md"
    },
    "a7": {
      "name": "Thank You + Upsell",
      "layer": "layer-4",
      "model": "claude-haiku-4-5",
      "role": "Confirmation copy, recurring gift upsell, social share prompt",
      "depends_on": ["a6"],
      "tools": ["stripe", "make", "supabase"],
      "outputs": ["outputs/copy/thankyou-upsell.json"],
      "file": "agents/a7-thankyou.md"
    },
    "a8": {
      "name": "Donor Nurture",
      "layer": "layer-5",
      "model": "claude-sonnet-4-5",
      "role": "5-email drip, impact reports, 60-day re-engagement, Klaviyo",
      "depends_on": ["a7"],
      "tools": ["klaviyo", "make", "supabase"],
      "outputs": ["outputs/nurture/email-sequence.json"],
      "file": "agents/a8-nurture.md"
    },
    "a9": {
      "name": "Analytics Optimizer",
      "layer": "layer-6",
      "model": "claude-sonnet-4-5",
      "role": "Conversion tracking, A/B scoring, swarm feedback loop",
      "depends_on": ["a8"],
      "tools": ["supabase", "make"],
      "outputs": ["outputs/analytics/report.json"],
      "feeds_back_to": "a0",
      "file": "agents/a9-analytics.md"
    },
    "qc2": {
      "name": "Ongoing QC",
      "layer": "gate-2",
      "model": "claude-haiku-4-5",
      "role": "Post-launch monitoring, copy drift, broken Stripe flows, donor complaints",
      "schedule": "0 9 * * *",
      "dispatch_ready": true,
      "tools": ["supabase", "make"],
      "outputs": ["outputs/qc-reports/ongoing.json"],
      "file": "agents/qc2-ongoing.md"
    },
    "r2": {
      "name": "Ongoing Researcher",
      "layer": "ongoing",
      "model": "claude-sonnet-4-5",
      "role": "Seasonal giving intel, grant opportunities, new donor persona signals",
      "schedule": "0 8 * * 1",
      "dispatch_ready": true,
      "tools": ["web_search", "supabase"],
      "outputs": ["outputs/research/weekly-brief.json"],
      "file": "agents/r2-ongoing.md"
    }
  },

  "mcp_servers": {
    "stripe": "https://mcp.stripe.com",
    "vercel": "https://mcp.vercel.com",
    "supabase": "https://mcp.supabase.com/mcp",
    "make": "https://mcp.make.com",
    "klaviyo": "https://mcp.klaviyo.com/mcp",
    "gmail": "https://gmail.mcp.claude.com/mcp"
  },

  "gift_tiers": [
    { "amount": 25, "label": "Feeds a family for a week" },
    { "amount": 50, "label": "Provides childcare for a day" },
    { "amount": 100, "label": "Sponsors a child's summer meals" },
    { "amount": 250, "label": "Funds a project L.E.A.P. session" },
    { "amount": 500, "label": "Furnishes a senior housing room" },
    { "amount": 1000, "label": "Campaign Partner — named recognition" }
  ],

  "campaign": {
    "goal": 1000000,
    "raised": 342000,
    "deadline": "2026-12-31",
    "cause": "Affordable senior housing, Rockdale County GA",
    "ein": "501c3",
    "sponsors": ["GADECAL", "United Way"]
  }
}
