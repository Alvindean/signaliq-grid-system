NODE_ENV=production
PORT=3000
SERVE_STATIC=true
JWT_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=thealvindean@gmail.com

# Set these to your live domain after deploy, e.g. https://app.yourdomain.com
APP_ORIGIN=https://your-live-domain.com
PUBLIC_APP_URL=https://your-live-domain.com
API_PUBLIC_URL=https://your-live-domain.com

# Live sending + tracking
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=whsec_xxx
RESEND_WEBHOOK_KEY=optional-fallback-random-key
SENDING_FROM=SignalIQ <hello@axistms.com>
CAMPAIGN_REPLY_TO=thealvindean@gmail.com

# Conversion attribution
CRM_WEBHOOK_KEY=crm_wh_random_key

# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=https://your-live-domain.com/api/google/callback

# Optional billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_TEAM_MONTHLY_PRICE_ID=

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
