<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Contact Dr. Anthony E. Dixon for speaking engagements, press inquiries, research consultations, and partnership opportunities.">
  <meta name="theme-color" content="#0a0e27">

  <!-- Canonical -->
  <link rel="canonical" href="https://profaedixon.com/contact.html">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Contact Dr. Anthony E. Dixon | Inquiries & Bookings">
  <meta property="og:description" content="Contact Dr. Anthony E. Dixon for speaking engagements, press inquiries, research consultations, and partnership opportunities.">
  <meta property="og:url" content="https://profaedixon.com/contact.html">
  <meta property="og:site_name" content="Dr. Anthony E. Dixon">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Contact Dr. Anthony E. Dixon | Inquiries & Bookings">
  <meta name="twitter:description" content="Contact Dr. Anthony E. Dixon for speaking engagements, press inquiries, research consultations, and partnership opportunities.">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;0,800;0,900;1,400;1,700;1,800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">

  <!-- Stylesheets -->
  <style>
/* ============================================
   CINEMATIC DESIGN SYSTEM
   profaedixon.com — Bold & Cinematic
   ============================================ */

:root {
  --ink: #0D0A04;
  --ink-warm: #1C1408;
  --parchment: #F5EFE0;
  --parchment-dark: #EDE4CC;
  --gold: #B8912A;
  --gold-light: #D4A843;
  --gold-glow: rgba(212,168,67,0.4);
  --sienna: #8B3A1C;
  --sienna-glow: rgba(139,58,28,0.3);
  --charcoal: #1A1510;
  --mist: #F9F5EC;
  --text: #2C2416;
  --text-muted: #6B5D45;
  --border: rgba(184,145,42,0.2);
  --ember: #C4621A;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
img { max-width: 100%; height: auto; display: block; }

body {
  font-family: 'DM Sans', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.7;
  color: var(--parchment);
  background: var(--ink);
  overflow-x: hidden;
}

a { color: var(--gold-light); text-decoration: none; transition: color 0.3s; }
a:hover { color: var(--gold-light); }

h1, h2, h3, h4 { font-family: 'Playfair Display', serif; font-weight: 700; line-height: 1.2; color: var(--parchment); }
h1 { font-size: clamp(32px, 5vw, 56px); }
h2 { font-size: clamp(24px, 3.5vw, 42px); }
h3 { font-size: clamp(20px, 2.5vw, 28px); }

/* --- Grain Overlay --- */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
  opacity: 0.5;
}

/* --- Utility --- */
.container { max-width: 1200px; margin: 0 auto; }
.section-label {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 16px;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -1px;
  margin-bottom: 24px;
}
.section-title em { color: var(--gold-light); font-style: italic; }

/* ---- NAVIGATION ---- */
.site-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(13,10,4,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(184,145,42,0.08);
  padding: 0 40px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: background 0.4s;
}
.nav-brand {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--parchment);
  letter-spacing: 1px;
  text-transform: uppercase;
  white-space: nowrap;
}
.nav-brand a { color: inherit; text-decoration: none; }
.nav-brand a:hover { color: var(--gold-light); }
.nav-links {
  display: flex; align-items: center; gap: 28px; list-style: none;
}
.nav-links a {
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.5);
  text-decoration: none;
  transition: color 0.3s;
  position: relative;
}
.nav-links a:hover, .nav-links a.active { color: var(--gold-light); }
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0;
  width: 0; height: 1px;
  background: var(--gold);
  transition: width 0.3s;
}
.nav-links a:hover::after { width: 100%; }
.nav-cta {
  background: var(--gold) !important;
  color: var(--ink) !important;
  padding: 10px 24px !important;
  border-radius: 0 !important;
  font-weight: 700 !important;
  letter-spacing: 2px !important;
  transition: all 0.3s !important;
}
.nav-cta::after { display: none !important; }
.nav-cta:hover { background: var(--gold-light) !important; transform: translateY(-1px); box-shadow: 0 4px 20px var(--gold-glow); }
.hamburger { display: none; background: none; border: none; color: var(--parchment); font-size: 24px; cursor: pointer; padding: 8px; line-height: 1; }
.nav-drawer {
  display: none;
  position: absolute;
  top: 72px; left: 0; right: 0;
  background: rgba(13,10,4,0.98);
  backdrop-filter: blur(20px);
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
}
.nav-drawer.open { max-height: 500px; padding: 16px 0; }
.nav-drawer a {
  display: flex; align-items: center;
  font-family: 'Syne', sans-serif;
  font-size: 13px; font-weight: 600;
  letter-spacing: 1.5px; text-transform: uppercase;
  color: rgba(245,239,224,0.7);
  padding: 14px 40px; min-height: 48px;
  text-decoration: none;
  transition: color 0.3s, background 0.3s;
}
.nav-drawer a:hover, .nav-drawer a.active { color: var(--gold-light); background: rgba(184,145,42,0.08); }

@media (max-width: 900px) {
  .site-nav { padding: 0 24px; }
  .nav-links { display: none; }
  .hamburger { display: block; }
  .nav-drawer { display: block; }
}

/* ---- HERO (Homepage) ---- */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 120px 48px 100px;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 50% 40%, rgba(139,58,28,0.15) 0%, transparent 70%),
    radial-gradient(ellipse 60% 80% at 70% 60%, rgba(184,145,42,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 100% 100% at 50% 100%, rgba(196,98,26,0.1) 0%, transparent 50%),
    linear-gradient(180deg, var(--ink) 0%, #0F0B05 50%, #110D06 100%);
  z-index: 0;
}
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(1px 1px at 20% 30%, var(--gold-light), transparent),
    radial-gradient(1.5px 1.5px at 40% 70%, var(--ember), transparent),
    radial-gradient(1px 1px at 60% 20%, var(--gold), transparent),
    radial-gradient(1.5px 1.5px at 80% 50%, var(--gold-light), transparent),
    radial-gradient(1px 1px at 10% 80%, var(--ember), transparent),
    radial-gradient(1px 1px at 90% 10%, var(--gold), transparent),
    radial-gradient(2px 2px at 50% 50%, rgba(212,168,67,0.3), transparent),
    radial-gradient(1px 1px at 30% 90%, var(--gold-light), transparent),
    radial-gradient(1px 1px at 70% 40%, var(--ember), transparent),
    radial-gradient(1.5px 1.5px at 15% 55%, var(--gold), transparent);
  animation: float-embers 20s linear infinite;
  opacity: 0.6;
  z-index: 1;
}
@keyframes float-embers {
  0% { transform: translateY(0) translateX(0); }
  25% { transform: translateY(-30px) translateX(10px); }
  50% { transform: translateY(-60px) translateX(-5px); }
  75% { transform: translateY(-30px) translateX(15px); }
  100% { transform: translateY(0) translateX(0); }
}
.hero-vignette {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 70% at 50% 50%, transparent 30%, rgba(13,10,4,0.7) 100%);
  z-index: 2;
}
.hero-content {
  position: relative; z-index: 3;
  text-align: center; max-width: 1000px;
}
.hero-label {
  font-family: 'Syne', sans-serif;
  font-size: clamp(10px, 1.5vw, 13px);
  font-weight: 700;
  letter-spacing: 6px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 28px;
  opacity: 0;
  animation: reveal-up 0.8s ease forwards 0.3s;
}
.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(56px, 10vw, 120px);
  font-weight: 900;
  line-height: 0.95;
  letter-spacing: -3px;
  margin-bottom: 8px;
  opacity: 0;
  animation: reveal-up 1s ease forwards 0.6s;
}
.hero-title em {
  color: var(--gold-light);
  font-style: italic;
  display: block;
  font-size: 1.05em;
  text-shadow: 0 0 80px var(--gold-glow);
}
.hero-subtitle {
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(15px, 1.8vw, 19px);
  font-weight: 300;
  line-height: 1.7;
  color: rgba(245,239,224,0.55);
  max-width: 600px;
  margin: 28px auto 48px;
  opacity: 0;
  animation: reveal-up 0.8s ease forwards 0.9s;
}
.hero-ctas {
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
  opacity: 0;
  animation: reveal-up 0.8s ease forwards 1.2s;
}
.hero-line {
  width: 1px; height: 80px;
  background: linear-gradient(180deg, var(--gold), transparent);
  margin: 60px auto 0;
  opacity: 0;
  animation: reveal-up 0.8s ease forwards 1.5s;
}
.scroll-hint {
  position: absolute;
  bottom: 32px; left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  opacity: 0;
  animation: reveal-up 0.6s ease forwards 2s;
}
.scroll-hint span {
  display: block;
  width: 1px; height: 40px;
  background: var(--gold);
  margin: 0 auto 8px;
  animation: scroll-pulse 2s ease-in-out infinite;
}
.scroll-hint p {
  font-family: 'Syne', sans-serif;
  font-size: 9px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.3);
}
@keyframes reveal-up {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes scroll-pulse {
  0%, 100% { opacity: 0.2; transform: scaleY(0.5); }
  50% { opacity: 1; transform: scaleY(1); }
}

/* ---- PAGE HEADER (Inner pages) ---- */
.page-header {
  position: relative;
  background: var(--ink);
  padding: 140px 48px 72px;
  color: var(--parchment);
  overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 60% 60% at 50% 40%, rgba(139,58,28,0.1) 0%, transparent 70%),
    radial-gradient(ellipse 80% 80% at 70% 70%, rgba(184,145,42,0.05) 0%, transparent 60%);
  pointer-events: none;
}
.page-header .container { position: relative; z-index: 1; }
.page-header .breadcrumb {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.4);
  margin-bottom: 24px;
}
.page-header .breadcrumb a { color: rgba(245,239,224,0.4); text-decoration: none; }
.page-header .breadcrumb a:hover { color: var(--gold-light); }
.page-header h1 { color: var(--parchment); margin-bottom: 16px; }
.page-header h1 em { color: var(--gold-light); font-style: italic; }
.page-header .subtitle {
  font-family: 'DM Sans', sans-serif;
  font-size: clamp(15px, 1.5vw, 18px);
  color: rgba(245,239,224,0.55);
  max-width: 640px;
  line-height: 1.7;
}

/* ---- BUTTONS ---- */
.btn {
  display: inline-block;
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 16px 36px;
  border: none;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  text-decoration: none;
  position: relative;
  overflow: hidden;
}
.btn-gold { background: var(--gold); color: var(--ink); }
.btn-gold:hover {
  background: var(--gold-light); color: var(--ink);
  box-shadow: 0 8px 40px var(--gold-glow);
  transform: translateY(-2px);
}
.btn-ghost {
  background: transparent;
  color: var(--parchment);
  border: 1px solid rgba(245,239,224,0.2);
}
.btn-ghost:hover {
  border-color: var(--gold); color: var(--gold-light);
  box-shadow: 0 0 30px rgba(184,145,42,0.1);
}
.btn-secondary {
  background: transparent;
  color: var(--parchment);
  border: 1px solid var(--border);
}
.btn-secondary:hover { border-color: var(--gold); color: var(--gold-light); }
.btn-sienna { background: var(--sienna); color: var(--parchment); }
.btn-sienna:hover { background: #A34420; color: var(--parchment); }

/* ---- SECTIONS ---- */
.section { position: relative; padding: 100px 48px; }
.section-dark { background: var(--ink); }
.section-warm { background: var(--charcoal); }
.section-parchment { background: var(--parchment); color: var(--ink); }
.section-mist { background: var(--mist); color: var(--ink); }

.section-parchment h2, .section-parchment h3,
.section-parchment .section-title { color: var(--ink); }
.section-parchment p { color: var(--text-muted); }
.section-parchment .section-title em,
.section-mist .section-title em { color: var(--sienna); }
.section-mist h2, .section-mist h3,
.section-mist .section-title { color: var(--ink); }
.section-mist p { color: var(--text-muted); }

/* Diagonal divider */
.divider-angle { position: relative; height: 80px; margin-top: -80px; }
.divider-angle::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 80px;
  background: inherit;
  clip-path: polygon(0 100%, 100% 0, 100% 100%);
}

/* ---- GRIDS ---- */
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
@media (max-width: 900px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}

/* ---- SCROLL ANIMATIONS ---- */
.reveal {
  opacity: 0; transform: translateY(40px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-left {
  opacity: 0; transform: translateX(-60px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal-left.visible { opacity: 1; transform: translateX(0); }
.reveal-right {
  opacity: 0; transform: translateX(60px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal-right.visible { opacity: 1; transform: translateX(0); }
.stagger .reveal:nth-child(1) { transition-delay: 0s; }
.stagger .reveal:nth-child(2) { transition-delay: 0.15s; }
.stagger .reveal:nth-child(3) { transition-delay: 0.3s; }
.stagger .reveal:nth-child(4) { transition-delay: 0.45s; }
.gold-line {
  width: 60px; height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--ember));
  margin: 32px 0;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.gold-line.visible { transform: scaleX(1); }

/* Legacy fade-in support */
.fade-in {
  opacity: 0; transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* ---- STATS BAR ---- */
.stats-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(184,145,42,0.15);
  border-bottom: 1px solid rgba(184,145,42,0.15);
}
.stat {
  text-align: center;
  padding: 48px 24px;
  border-right: 1px solid rgba(184,145,42,0.1);
}
.stat:last-child { border-right: none; }
.stat-number {
  font-family: 'Playfair Display', serif;
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 800;
  color: var(--gold-light);
  line-height: 1;
  margin-bottom: 8px;
}
.stat-label {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.4);
}
@media (max-width: 768px) {
  .stats-bar { grid-template-columns: repeat(2, 1fr); }
  .stat { border-bottom: 1px solid rgba(184,145,42,0.1); }
}

/* ---- ABOUT GRID ---- */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.about-quote {
  font-family: 'Playfair Display', serif;
  font-size: clamp(24px, 3vw, 36px);
  font-style: italic;
  font-weight: 700;
  line-height: 1.3;
  color: var(--parchment);
  position: relative;
  padding-left: 32px;
}
.about-quote::before {
  content: '';
  position: absolute;
  left: 0; top: 0;
  width: 3px; height: 100%;
  background: linear-gradient(180deg, var(--gold), var(--ember));
  border-radius: 2px;
}
.about-text {
  font-size: 16px; line-height: 1.8;
  color: rgba(245,239,224,0.6);
}
.about-text a {
  color: var(--gold-light); text-decoration: none;
  border-bottom: 1px solid rgba(212,168,67,0.3);
  transition: border-color 0.3s;
}
.about-text a:hover { border-color: var(--gold-light); }
@media (max-width: 900px) {
  .about-grid { grid-template-columns: 1fr; gap: 40px; }
}

/* ---- BOOK CARDS ---- */
.books-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.book-card {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(184,145,42,0.1);
  position: relative;
  overflow: hidden;
  transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  display: block;
}
.book-card:hover {
  border-color: var(--gold);
  transform: translateY(-8px);
  box-shadow: 0 20px 60px rgba(0,0,0,0.4), 0 0 40px var(--gold-glow);
}
.book-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--ember), var(--gold));
  opacity: 0;
  transition: opacity 0.5s;
}
.book-card:hover::before { opacity: 1; }
.book-cover {
  height: 280px;
  background: linear-gradient(135deg, #1a1510 0%, #2a1f14 50%, #1a1510 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.book-cover::after {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(circle at 30% 40%, rgba(184,145,42,0.08), transparent 60%);
}
.book-cover-text {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--gold-light);
  text-align: center;
  padding: 24px;
  z-index: 1;
  line-height: 1.3;
}
.book-info { padding: 28px 24px 32px; }
.book-year {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 10px;
}
.book-title {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--parchment);
  margin-bottom: 10px;
  line-height: 1.3;
}
.book-desc {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
}
@media (max-width: 900px) {
  .books-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
}

/* ---- SPEAKING TOPICS ---- */
.topics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.topic-card {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(245,239,224,0.06);
  padding: 36px 32px;
  transition: all 0.4s;
  position: relative;
  overflow: hidden;
}
.topic-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 0; height: 2px;
  background: var(--gold);
  transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.topic-card:hover::before { width: 100%; }
.topic-card:hover {
  border-color: rgba(184,145,42,0.2);
  background: rgba(184,145,42,0.04);
}
.topic-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 20px;
  font-weight: 700;
  color: var(--parchment);
  margin-bottom: 12px;
}
.topic-card p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
}
@media (max-width: 768px) {
  .topics-grid { grid-template-columns: 1fr; }
}

/* ---- DIVISION CARDS (AHRA) ---- */
.division-card {
  background: rgba(245,239,224,0.02);
  border: 1px solid rgba(245,239,224,0.06);
  padding: 40px 32px;
  position: relative;
  transition: all 0.4s;
}
.division-card:hover {
  border-color: var(--gold);
  background: rgba(184,145,42,0.04);
  box-shadow: 0 12px 40px rgba(0,0,0,0.3);
}
.division-icon { font-size: 32px; margin-bottom: 20px; }
.division-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  font-weight: 700;
  color: var(--parchment);
  margin-bottom: 12px;
}
.division-card p {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
  margin-bottom: 20px;
}
.division-services { list-style: none; margin-bottom: 24px; }
.division-services li {
  font-size: 13px;
  color: rgba(245,239,224,0.4);
  padding: 6px 0;
  border-bottom: 1px solid rgba(245,239,224,0.04);
  padding-left: 16px;
  position: relative;
}
.division-services li::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  width: 6px; height: 1px;
  background: var(--gold);
}

/* ---- PROJECT HERO ---- */
.project-hero {
  position: relative;
  background: var(--ink);
  padding: 160px 48px 100px;
  color: var(--parchment);
  overflow: hidden;
}
.project-hero::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 60% 80% at 40% 50%, rgba(196,98,26,0.1), transparent),
    radial-gradient(ellipse 50% 60% at 70% 40%, rgba(139,58,28,0.08), transparent);
  pointer-events: none;
}
.project-hero .container { position: relative; z-index: 1; }
.project-hero .hero-badge {
  font-family: 'Syne', sans-serif;
  font-size: 10px; font-weight: 700;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 28px;
}
.project-hero h1 {
  font-size: clamp(48px, 8vw, 96px);
  font-weight: 900;
  line-height: 0.95;
  letter-spacing: -2px;
  margin-bottom: 24px;
}
.project-hero h1 em {
  color: var(--gold-light);
  font-style: italic;
  display: block;
  text-shadow: 0 0 60px var(--gold-glow);
}
.project-hero .hero-subhead {
  font-size: clamp(16px, 2vw, 20px);
  font-weight: 300;
  color: rgba(245,239,224,0.55);
  max-width: 600px;
  line-height: 1.7;
  margin-bottom: 40px;
}
.project-hero .hero-year {
  font-family: 'Playfair Display', serif;
  font-size: clamp(120px, 20vw, 300px);
  font-weight: 900;
  font-style: italic;
  color: rgba(184,145,42,0.04);
  position: absolute;
  right: -20px; top: 50%;
  transform: translateY(-50%);
  line-height: 1; z-index: 0;
  pointer-events: none;
}

/* ---- BIG NUMBER WATERMARK ---- */
.watermark {
  font-family: 'Playfair Display', serif;
  font-size: clamp(120px, 20vw, 300px);
  font-weight: 900;
  font-style: italic;
  color: rgba(184,145,42,0.04);
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  line-height: 1;
  z-index: 0;
  pointer-events: none;
}

/* ---- CTA STRIP ---- */
.cta-strip {
  position: relative;
  padding: 100px 48px;
  text-align: center;
  background: var(--charcoal);
  overflow: hidden;
}
.cta-strip::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 50% 80% at 50% 50%, rgba(184,145,42,0.06), transparent);
}
.cta-strip h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(32px, 4vw, 56px);
  font-weight: 800;
  font-style: italic;
  color: var(--parchment);
  margin-bottom: 16px;
  position: relative;
}
.cta-strip p {
  font-size: 16px;
  color: rgba(245,239,224,0.5);
  max-width: 480px;
  margin: 0 auto 36px;
  position: relative;
}

/* ---- EMAIL CAPTURE ---- */
.email-section { position: relative; overflow: hidden; }
.email-section::before {
  content: '';
  position: absolute;
  top: -50%; left: 50%;
  transform: translateX(-50%);
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(184,145,42,0.06), transparent 70%);
  border-radius: 50%;
}
.email-form {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 500px;
  margin: 0 auto;
  position: relative;
}
.email-form input[type="email"] {
  flex: 1;
  min-width: 260px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(184,145,42,0.2);
  color: var(--parchment);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  padding: 16px 20px;
  outline: none;
  transition: all 0.3s;
}
.email-form input[type="email"]:focus {
  border-color: var(--gold);
  box-shadow: 0 0 20px rgba(184,145,42,0.1);
}

/* ---- FORMS ---- */
.form-group { margin-bottom: 20px; }
.form-group label {
  display: block;
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.5);
  margin-bottom: 8px;
}
.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(245,239,224,0.12);
  color: var(--parchment);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  padding: 14px 18px;
  border-radius: 0;
  outline: none;
  transition: border-color 0.3s;
}
.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus { border-color: var(--gold); box-shadow: 0 0 20px rgba(184,145,42,0.08); }
.form-group textarea { resize: vertical; min-height: 120px; }
.form-group select option { background: var(--charcoal); color: var(--parchment); }

/* Parchment form variant (light bg) */
.form-parchment label { color: var(--text-muted); }
.form-parchment input,
.form-parchment textarea,
.form-parchment select {
  background: rgba(255,255,255,0.6);
  border-color: var(--border);
  color: var(--text);
}

/* ---- WHY CARDS ---- */
.why-card {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(245,239,224,0.06);
  padding: 36px 28px;
  transition: all 0.4s;
}
.why-card:hover {
  border-color: rgba(184,145,42,0.2);
  background: rgba(184,145,42,0.04);
}
.why-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 700;
  color: var(--parchment);
  margin-bottom: 12px;
}
.why-card p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
}

/* ---- PROJECT CARDS ---- */
.project-card {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(184,145,42,0.1);
  padding: 40px 32px;
  position: relative;
  transition: all 0.4s;
}
.project-card:hover {
  border-color: var(--gold);
  box-shadow: 0 12px 40px rgba(0,0,0,0.3);
}
.card-badge {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 16px;
}
.project-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  color: var(--parchment);
  margin-bottom: 16px;
}
.project-card p {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
  margin-bottom: 8px;
}
.project-card strong { color: rgba(245,239,224,0.7); }
.project-card em { color: var(--gold-light); }

/* ---- PROCESS STEPS ---- */
.process-step {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  margin-bottom: 40px;
}
.process-number {
  font-family: 'Playfair Display', serif;
  font-size: 48px;
  font-weight: 800;
  color: var(--gold);
  line-height: 1;
  min-width: 60px;
}
.process-content h3 {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--parchment);
  margin-bottom: 8px;
}
.process-content p {
  font-size: 15px;
  color: rgba(245,239,224,0.6);
  line-height: 1.7;
}
@media (max-width: 600px) {
  .process-step { flex-direction: column; gap: 8px; }
  .process-number { font-size: 36px; }
}

/* ---- FAQ ---- */
.faq-item { border-bottom: 1px solid rgba(184,145,42,0.15); padding: 24px 0; }
.faq-item:last-child { border-bottom: none; }
.faq-question {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--parchment);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.faq-question::after { content: '+'; font-size: 20px; color: var(--gold); transition: transform 0.3s; }
.faq-item.open .faq-question::after { content: '\2212'; }
.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
  font-size: 15px;
  color: rgba(245,239,224,0.5);
  line-height: 1.7;
}
.faq-item.open .faq-answer { max-height: 300px; padding-top: 16px; }

/* ---- PULL QUOTE ---- */
.pull-quote {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: clamp(20px, 2.5vw, 32px);
  line-height: 1.4;
  color: var(--parchment);
  position: relative;
  padding-left: 28px;
  margin: 40px 0;
}
.pull-quote::before {
  content: '';
  position: absolute;
  left: 0; top: 0;
  width: 3px; height: 100%;
  background: linear-gradient(180deg, var(--gold), var(--ember));
}

/* ---- CREDENTIAL GRID (About page) ---- */
.credential-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.credential-item {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(245,239,224,0.06);
  padding: 32px 24px;
  text-align: center;
  transition: all 0.4s;
}
.credential-item:hover {
  border-color: rgba(184,145,42,0.2);
  background: rgba(184,145,42,0.04);
}
.credential-item .number {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  font-weight: 800;
  color: var(--gold-light);
  margin-bottom: 8px;
}
.credential-item .label {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.4);
}
@media (max-width: 768px) {
  .credential-grid { grid-template-columns: 1fr; }
}

/* ---- CONTACT GRID ---- */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}
.contact-info h3 {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  color: var(--parchment);
  margin-bottom: 24px;
}
.contact-detail {
  margin-bottom: 24px;
}
.contact-detail .detail-label {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 6px;
}
.contact-detail p, .contact-detail a {
  font-size: 15px;
  color: rgba(245,239,224,0.6);
  line-height: 1.7;
}
.contact-detail a:hover { color: var(--gold-light); }
.social-links { display: flex; gap: 16px; margin-top: 32px; }
.social-links a {
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.5);
  padding: 10px 20px;
  border: 1px solid rgba(245,239,224,0.1);
  transition: all 0.3s;
}
.social-links a:hover {
  color: var(--gold-light);
  border-color: var(--gold);
}
@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; }
}

/* ---- BLOG STYLES ---- */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
}
.blog-card {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(184,145,42,0.1);
  padding: 36px 32px;
  transition: all 0.4s;
  position: relative;
  overflow: hidden;
}
.blog-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 0; height: 2px;
  background: var(--gold);
  transition: width 0.6s;
}
.blog-card:hover::before { width: 100%; }
.blog-card:hover {
  border-color: var(--gold);
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.3);
}
.blog-card .category {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}
.blog-card h3 { margin-bottom: 12px; }
.blog-card h3 a { color: var(--parchment); text-decoration: none; }
.blog-card h3 a:hover { color: var(--gold-light); }
.blog-card .excerpt {
  font-size: 14px;
  color: rgba(245,239,224,0.5);
  line-height: 1.7;
  margin-bottom: 16px;
}
.blog-card .meta {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  letter-spacing: 1px;
  color: rgba(245,239,224,0.35);
}
@media (max-width: 768px) {
  .blog-grid { grid-template-columns: 1fr; }
}

/* Blog article body */
.article-body { max-width: 720px; margin: 0 auto; }
.article-body p {
  margin-bottom: 20px;
  font-size: 16px; line-height: 1.8;
  color: rgba(245,239,224,0.7);
}
.article-body h2 {
  margin: 48px 0 20px;
  font-size: clamp(22px, 2.5vw, 32px);
  color: var(--parchment);
}
.article-body h3 {
  margin: 36px 0 16px;
  font-size: clamp(18px, 2vw, 24px);
  color: var(--parchment);
}
.article-body ul, .article-body ol { margin: 0 0 20px 24px; }
.article-body li {
  margin-bottom: 8px;
  line-height: 1.7;
  color: rgba(245,239,224,0.6);
}
.article-body blockquote {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 18px;
  line-height: 1.6;
  border-left: 3px solid var(--gold);
  padding: 16px 24px;
  margin: 32px 0;
  color: var(--parchment);
  background: rgba(184,145,42,0.04);
}
.article-body a { color: var(--gold-light); border-bottom: 1px solid rgba(212,168,67,0.3); }
.article-body a:hover { border-color: var(--gold-light); }

/* Author bio in articles */
.author-bio {
  background: rgba(245,239,224,0.03);
  border: 1px solid rgba(184,145,42,0.1);
  padding: 32px;
  margin-top: 48px;
}
.author-bio h4 {
  font-family: 'Syne', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
}
.author-bio p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
}

/* ---- FOOTER ---- */
.site-footer {
  background: var(--ink);
  border-top: 1px solid rgba(184,145,42,0.08);
  padding: 64px 48px 0;
}
.footer-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 32px;
  padding-bottom: 48px;
}
.footer-brand h3 {
  font-family: 'Syne', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--parchment);
  margin-bottom: 8px;
}
.footer-brand p { font-size: 13px; color: rgba(245,239,224,0.3); }
.footer-nav { display: flex; gap: 28px; flex-wrap: wrap; }
.footer-nav a {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.35);
  text-decoration: none;
  transition: color 0.3s;
}
.footer-nav a:hover { color: var(--gold-light); }
.footer-bottom {
  border-top: 1px solid rgba(245,239,224,0.05);
  padding: 24px 0;
  font-size: 11px;
  color: rgba(245,239,224,0.2);
  text-align: center;
  line-height: 1.8;
}
.footer-bottom a { color: rgba(245,239,224,0.3); text-decoration: none; }
.footer-bottom a:hover { color: var(--gold-light); }

@media (max-width: 768px) {
  .section, .cta-strip { padding: 80px 24px; }
  .hero { padding: 100px 24px 80px; }
  .page-header, .project-hero { padding-left: 24px; padding-right: 24px; }
  .site-footer { padding: 48px 24px 0; }
  .footer-main { flex-direction: column; text-align: center; }
  .footer-nav { justify-content: center; }
}

/* ---- 404 PAGE ---- */
.error-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 120px 48px;
  position: relative;
  overflow: hidden;
}
.error-page::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(139,58,28,0.08), transparent);
}
.error-number {
  font-family: 'Playfair Display', serif;
  font-size: clamp(120px, 25vw, 280px);
  font-weight: 900;
  font-style: italic;
  color: rgba(184,145,42,0.08);
  line-height: 1;
  margin-bottom: -20px;
}
.error-page h1 {
  font-size: clamp(28px, 4vw, 48px);
  color: var(--parchment);
  margin-bottom: 16px;
}
.error-page p {
  color: rgba(245,239,224,0.5);
  font-size: 16px;
  margin-bottom: 40px;
}
.error-links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

/* ============================================
   HOMEPAGE-SPECIFIC CLASSES
   (used by index.html agent build)
   ============================================ */

/* CTA buttons (homepage variant names) */
.cta-primary {
  display: inline-block;
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 16px 36px;
  background: var(--gold);
  color: var(--ink);
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.cta-primary:hover {
  background: var(--gold-light);
  color: var(--ink);
  box-shadow: 0 8px 40px var(--gold-glow);
  transform: translateY(-2px);
}
.cta-secondary {
  display: inline-block;
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 16px 36px;
  background: transparent;
  color: var(--parchment);
  border: 1px solid rgba(245,239,224,0.2);
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.cta-secondary:hover {
  border-color: var(--gold);
  color: var(--gold-light);
  box-shadow: 0 0 30px rgba(184,145,42,0.1);
}

/* Gold italic title span */
.gold-italic {
  color: var(--gold-light);
  font-style: italic;
  display: block;
  font-size: 1.05em;
  text-shadow: 0 0 80px var(--gold-glow);
}

/* Reveal-up / reveal-top animations */
.reveal-up {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal-up.visible { opacity: 1; transform: translateY(0); }
.reveal-top {
  opacity: 0;
  transform: translateY(-20px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal-top.visible { opacity: 1; transform: translateY(0); }

/* Stat items (homepage) */
.stat-item {
  text-align: center;
  padding: 48px 24px;
  border-right: 1px solid rgba(184,145,42,0.1);
}
.stat-item:last-child { border-right: none; }
@media (max-width: 768px) {
  .stat-item { border-bottom: 1px solid rgba(184,145,42,0.1); border-right: none; }
}

/* Section header (centered) */
.section-header {
  text-align: center;
  margin-bottom: 60px;
}
.section-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 800;
  color: var(--parchment);
  margin-bottom: 16px;
}
.section-header p {
  font-size: 16px;
  color: rgba(245,239,224,0.5);
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.7;
}

/* Section CTA (centered) */
.section-cta {
  text-align: center;
  margin-top: 48px;
}

/* Section watermark (III, 1835) */
.section-watermark {
  font-family: 'Playfair Display', serif;
  font-size: clamp(120px, 20vw, 300px);
  font-weight: 900;
  font-style: italic;
  color: rgba(184,145,42,0.04);
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  line-height: 1;
  z-index: 0;
  pointer-events: none;
}

/* About section specifics */
.about-section .about-grid { max-width: 1200px; margin: 0 auto; }
.about-quote blockquote {
  font-family: 'Playfair Display', serif;
  font-size: clamp(24px, 3vw, 36px);
  font-style: italic;
  font-weight: 700;
  line-height: 1.3;
  color: var(--parchment);
  padding-left: 32px;
  border-left: 3px solid;
  border-image: linear-gradient(180deg, var(--gold), var(--ember)) 1;
}
.about-text p {
  font-size: 16px;
  line-height: 1.8;
  color: rgba(245,239,224,0.6);
  margin-bottom: 20px;
}

/* Book card extras */
.book-category {
  font-size: 13px;
  color: rgba(245,239,224,0.4);
  margin-bottom: 12px;
  font-style: italic;
}
.book-description {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(245,239,224,0.5);
  margin-bottom: 16px;
}
.book-link {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold-light);
  text-decoration: none;
  border-bottom: 1px solid rgba(212,168,67,0.3);
  padding-bottom: 2px;
  transition: all 0.3s;
}
.book-link:hover { border-color: var(--gold-light); }
.books-section, .black-seminole-teaser, .speaking-section, .ahra-section, .blog-section {
  position: relative;
  overflow: hidden;
}

/* Divisions grid (homepage AHRA) */
.divisions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
@media (max-width: 900px) { .divisions-grid { grid-template-columns: 1fr; } }

/* Blog extras (homepage) */
.blog-link {
  font-family: 'Syne', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold-light);
  text-decoration: none;
}
.blog-link:hover { color: var(--gold); }

/* Project teaser (homepage) */
.teaser-content {
  max-width: 700px;
  position: relative;
  z-index: 1;
}
.teaser-content h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(36px, 5vw, 64px);
  font-weight: 800;
  font-style: italic;
  color: var(--parchment);
  margin-bottom: 24px;
}
.teaser-content p {
  font-size: 16px;
  color: rgba(245,239,224,0.55);
  line-height: 1.8;
  margin-bottom: 16px;
}
.teaser-ctas {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  position: relative;
  z-index: 1;
  margin-top: 32px;
}

/* Email section (homepage) */
.email-section { background: var(--charcoal); text-align: center; }
.email-content {
  max-width: 600px;
  margin: 0 auto;
  position: relative;
}
.email-content h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3.5vw, 44px);
  font-style: italic;
  color: var(--parchment);
  margin-bottom: 16px;
}
.email-content > p {
  font-size: 15px;
  color: rgba(245,239,224,0.45);
  margin-bottom: 36px;
  line-height: 1.7;
}
.email-form .form-group {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}
.email-form input[type="email"] {
  flex: 1;
  min-width: 260px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(184,145,42,0.2);
  color: var(--parchment);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  padding: 16px 20px;
  outline: none;
  transition: all 0.3s;
}
.email-form input[type="email"]:focus {
  border-color: var(--gold);
  box-shadow: 0 0 20px rgba(184,145,42,0.1);
}
.form-note {
  font-size: 11px;
  color: rgba(245,239,224,0.2);
  margin-top: 16px;
}

/* Scroll hint (homepage hero) */
.scroll-hint span {
  font-family: 'Syne', sans-serif;
  font-size: 9px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(245,239,224,0.3);
  display: block;
  margin-bottom: 8px;
}
.scroll-hint svg {
  color: var(--gold);
  animation: scroll-pulse 2s ease-in-out infinite;
}

/* Hero line */
.hero .hero-line, .reveal-top {
  width: 60px;
  height: 2px;
  background: linear-gradient(90deg, var(--gold), var(--ember));
  margin: 0 auto 32px;
}

</style>

